DATABASE_PASSWORD=replace-with-a-long-random-database-password
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=/api
# Enable only for a local walkthrough. Keep false for public deployments.
DEMO_DATA_ENABLED=false
